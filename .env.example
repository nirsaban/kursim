# App user connection (non-superuser, subject to RLS)
DATABASE_URL=postgresql://kursim_app:kursim_app_pw@localhost:5432/kursim
# Superuser connection used ONLY for migrations/seed
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kursim
REDIS_URL=redis://localhost:6379
# 32+ byte random secret for JWT signing (openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
APP_URL=http://localhost:3000
# Cloudinary (required for video upload/playback and landing galleries)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local store for lesson videos larger than the Cloudinary plan's cap (100MB on
# Free). MEDIA_ROOT must be a mounted volume (compose mounts `mediadata` there)
# or uploads are lost on the next image rebuild. Playback goes through a signed,
# expiring URL derived from AUTH_SECRET — the directory is never served directly.
MEDIA_ROOT=/app/media
# Optional per-video ceiling in bytes. Unset means no limit — a single upload
# can then fill the disk, which this server shares with other projects.
MEDIA_MAX_UPLOAD_BYTES=
# Initial platform administrator (created by the seed on first boot)
SEED_SUPERADMIN_EMAIL=admin@kursim.local
SEED_SUPERADMIN_PASSWORD=Admin1234!
# Affiliate program: unique landing-page visitors needed to earn one coin
AFFILIATE_VISITS_PER_COIN=100
# Gemini AI course-media generation (Veo video -> 240 scroll frames + Imagen stills).
# Prompt-writer, video, and image are all Gemini. Get a key at aistudio.google.com.
AI_MEDIA_ENABLED=false
# Veo billing is per-generation and expensive. Kept off independently of
# AI_MEDIA_ENABLED (Imagen stills still work without it) — only flip to true
# deliberately, after confirming the pipeline (ffmpeg, Imagen aspect ratios)
# is actually healthy, since a failed run after Veo succeeds still burns the cost.
AI_VIDEO_ENABLED=false
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
# Lesson-video transcription + attachment text extraction (feeds the mentor
# brain). ON automatically whenever GEMINI_API_KEY is set — transcription is a
# one-time cost per lesson, unlike Veo. Set TRANSCRIPTION_ENABLED=false to stop
# new jobs (already-stored transcripts keep serving the mentor).
TRANSCRIPTION_ENABLED=true
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
# Worker-side parallelism / retry count for transcription jobs. The knowledge
# indexing stage (chunk + embed + activate) runs on this same worker/queue,
# gated by the same TRANSCRIPTION_ENABLED switch.
TRANSCRIPTION_CONCURRENCY=2
TRANSCRIPTION_MAX_ATTEMPTS=3
# Course knowledge pipeline (RAG for the mentor): embedding model + chunking +
# retrieval. gemini-embedding-001 defaults to 3072 dims but is truncated to
# 768 (output_dimensionality) to match the KnowledgeChunk migration's
# `vector(768)` column; changing the model/dimension requires a new migration.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
RAG_TOP_K=6
# WhatsApp (Baileys / WhatsApp Web) — used to send students their login after a
# Grow purchase. No API keys needed: the super-admin pairs one number by scanning
# a QR at /superadmin/whatsapp. The socket runs in the worker; auth persists in Redis.
BAILEYS_LOG_LEVEL=silent

# SMTP — transactional mail (purchase receipts + owner sale alerts).
# Leave SMTP_HOST empty to disable email delivery entirely.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret for the periodic email-automation sweep
# (POST /api/cron/automations?secret=...). Empty disables the endpoint.
CRON_SECRET=

# Grow payment links for the three sellable packages (platform billing).
# Shown on /t/<slug>/admin/plan; empty = "contact us" until configured.
GROW_PLAN_LINK_STARTER=
GROW_PLAN_LINK_GROWTH=
GROW_PLAN_LINK_UNLIMITED=

# Secret for the package-payment webhook (/api/pay/plan?k=...) — one URL for all
# packages, set as the server callback on every Grow package page. Generate with:
# openssl rand -hex 24. The full URL to paste shows on the superadmin packages page.
PLAN_WEBHOOK_SECRET=

# Phone (Israeli format) that gets a WhatsApp ping when the lead bot books a meeting.
PLATFORM_ADMIN_PHONE=
