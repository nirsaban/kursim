generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EvictionPolicy {
  BLOCK
  EVICT_OLDEST
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum AttachmentKind {
  DOC
  IMAGE
  OTHER
}

/// Where a lesson video lives. Cloudinary caps an upload at the plan's video
/// size (100MB on Free), so anything larger is stored on this server's own
/// disk under MEDIA_ROOT instead.
enum MediaProvider {
  CLOUDINARY
  LOCAL
}

model Tenant {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique
  name           String
  status         TenantStatus   @default(ACTIVE)
  /// Billing package: FREE | STARTER | GROWTH | UNLIMITED (see lib/billing.ts).
  /// FREE builds courses but can't invite students or publish landing pages.
  plan            String    @default("FREE")
  planActivatedAt DateTime?
  sessionLimit   Int            @default(3)
  evictionPolicy EvictionPolicy @default(BLOCK)
  /// Owner-customizable student-home content (validated by homepageSchema).
  homepage       Json?
  /// Owner branding: logo (small data URL), accent color, applied across the
  /// student UI + login (validated by brandingSchema).
  branding       Json?
  /// Academy terms gate: when enabled, students must accept before entering
  /// (validated by termsSchema). Bumping `version` re-prompts everyone.
  terms          Json?
  /// Secret embedded in the Grow payment-webhook URL to authenticate callbacks.
  webhookSecret  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users            User[]
  courses          Course[]
  invites          Invite[]
  modules          Module[]
  lessons          Lesson[]
  attachments      Attachment[]
  enrollments      Enrollment[]
  progress         Progress[]
  reviews          CourseReview[]
  affiliateLinks   AffiliateLink[]
  courseMedia      CourseMedia[]
  learningActivity LearningActivity[]
  authTokens       AuthToken[]
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String?    @db.Uuid
  email              String
  name               String?
  passwordHash       String
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  /// WhatsApp phone (normalized 972…) — how the AI mentor recognizes the
  /// student when they message the school's number. Filled from purchases.
  phone                String?
  /// When the user accepted the tenant's terms, and which version. Null (or a
  /// stale version) with the gate enabled blocks the student UI until accepted.
  acceptedTermsAt      DateTime?
  acceptedTermsVersion Int       @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  progress         Progress[]
  reviews          CourseReview[]
  affiliateLinks   AffiliateLink[]
  learningActivity LearningActivity[]
  authTokens       AuthToken[]

  @@unique([tenantId, email])
}

enum AuthTokenKind {
  RESET
}

/// Single-use, expiring token emailed to a user who can't log in. Only the
/// SHA-256 hash of the token is stored (same contract as Invite.tokenHash).
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  userId    String        @db.Uuid
  kind      AuthTokenKind @default(RESET)
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  tokenHash String    @unique
  email     String?
  role      UserRole  @default(STUDENT)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  title            String
  description      String?      @db.Text
  coverPublicId    String?
  status           CourseStatus @default(DRAFT)
  /// Short per-tenant catalog number the owner puts in the matching Grow
  /// product's "catalog_number" field. The payment callback matches on it to
  /// tell which course a buyer actually bought, so a bundle link can grant
  /// only what was paid for. Auto-assigned as max+1 on create; owner-editable.
  catalogNumber    Int
  /// Sale price in agorot (₪49.90 = 4990). Null means the course isn't sold
  /// through Hyp checkout — the landing CTA falls back to `marketing.paymentLink`.
  /// Agorot, not a decimal, so the amount we sign is exactly the amount we charge.
  priceAgorot      Int?
  marketing        Json?
  /// Owner toggle for the WhatsApp AI mentor on this course (plan-gated too).
  mentorEnabled    Boolean      @default(true)
  landingPublished Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules        Module[]
  enrollments    Enrollment[]
  reviews        CourseReview[]
  affiliateLinks AffiliateLink[]
  media          CourseMedia?

  @@unique([tenantId, catalogNumber])
}

/// AI-generated marketing media for a course landing page: a Veo video rendered
/// as a 240-frame scroll-scrubbed hero sequence, plus Imagen stills. Public
/// (landing pages are public); the "media is never public" rule still governs lessons.
model CourseMedia {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  courseId      String   @unique @db.Uuid
  /// idle | generating | ready | failed
  status        String   @default("idle")
  /// Cloudinary base URL; individual frames appended as /frame_0001.jpg … frame_0240.jpg
  framesBaseUrl String?
  frameCount    Int      @default(240)
  posterUrl     String?
  videoUrl      String?
  /// [{ role, url, aspectRatio }]
  stills        Json?
  /// The full Gemini prompt-writer output, kept for re-runs and debugging.
  promptJson    Json?
  error         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CourseReview {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  courseId    String   @db.Uuid
  studentId   String   @db.Uuid
  name        String   @default("")
  rating      Int
  text        String   @db.Text
  /**
   * Private feedback for the owner — never shown on the landing page.
   */
  privateNote String   @default("") @db.Text
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

model AffiliateLink {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  courseId  String   @db.Uuid
  studentId String   @db.Uuid
  /**
   * Short public share code carried as ?ref= on the landing page.
   */
  code      String   @unique
  /**
   * Unique visitors who opened the landing page via this link.
   */
  visits    Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

model Module {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  courseId  String @db.Uuid
  title     String
  sortOrder Int    @default(0)
  /// Drip release: unlock this module only N days after the student enrolls (0 = immediate).
  dripDays  Int    @default(0)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  moduleId      String        @db.Uuid
  title         String
  notes         String?       @db.Text
  /// Auto-generated transcript of the lesson video — mentor knowledge source.
  transcript    String?       @db.Text
  videoPublicId String?
  videoProvider MediaProvider @default(CLOUDINARY)
  durationSec   Int?
  sortOrder     Int           @default(0)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  progress    Progress[]
}

model Attachment {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @db.Uuid
  lessonId String         @db.Uuid
  publicId String
  filename String
  kind     AttachmentKind @default(OTHER)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Progress {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  studentId       String    @db.Uuid
  lessonId        String    @db.Uuid
  lastPositionSec Int       @default(0)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

/// One row per student per active learning day (any progress write that day).
/// Powers the streak counter and the journey activity calendar.
model LearningActivity {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  /// Calendar day in Asia/Jerusalem, stored as a DATE.
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId])
  @@index([tenantId, studentId])
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Extended platform features. All are tenant-owned (denormalized tenantId +
// RLS in the matching migration + registered in scoped-prisma TENANT_MODELS).
// FKs (incl. ON DELETE CASCADE) live in the migration SQL; author/student
// display names are denormalized to avoid a web of User back-relations.
// ─────────────────────────────────────────────────────────────────────────────

/// In-app notification for one user (bell menu). Fed by broadcasts, Q&A answers,
/// community replies, new reviews, certificates, etc.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  /// broadcast | qa_answer | community_reply | review | certificate | enroll
  type      String
  title     String
  body      String    @default("") @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, createdAt])
}

/// A message an owner blasts to students; delivery fans out into Notifications.
model Broadcast {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  authorId  String   @db.Uuid
  /// null = all students in the tenant; otherwise students enrolled in this course.
  courseId  String?  @db.Uuid
  subject   String
  body      String   @db.Text
  sentCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// A discussion thread in the tenant community.
model CommunityPost {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  authorId   String   @db.Uuid
  authorName String
  authorRole String
  title      String
  body       String   @db.Text
  pinned     Boolean  @default(false)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, pinned, createdAt])
}

/// A reply under a CommunityPost.
model CommunityReply {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  postId     String   @db.Uuid
  authorId   String   @db.Uuid
  authorName String
  authorRole String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([tenantId, postId, createdAt])
}

/// A student's question on a lesson, answered by staff.
model LessonQuestion {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  lessonId     String    @db.Uuid
  courseId     String    @db.Uuid
  studentId    String    @db.Uuid
  studentName  String
  body         String    @db.Text
  answer       String    @default("") @db.Text
  answeredById String?   @db.Uuid
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, lessonId, createdAt])
}

/// A code a student redeems to enroll in a course for free (giveaways / manual sales).
model AccessCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  courseId  String    @db.Uuid
  code      String    @unique
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, courseId])
}

/// A certificate issued when a student completes a course.
model Certificate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  courseId    String   @db.Uuid
  studentId   String   @db.Uuid
  studentName String   @default("")
  courseTitle String   @default("")
  serial      String   @unique
  issuedAt    DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([tenantId])
}

/// A student's private notes on one lesson.
model LessonNote {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  lessonId  String   @db.Uuid
  courseId  String   @db.Uuid
  body      String   @default("") @db.Text
  updatedAt DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([tenantId, studentId])
}

/// A catalog course a student saved for later.
model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([tenantId, studentId])
}

/// A WhatsApp message the tenant sent (login deliveries, resends). Recorded when
/// queued, then updated by the worker gateway to sent/failed — powers the log.
model WhatsappMessage {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  toPhone   String
  body      String    @db.Text
  kind      String    @default("login")
  /// queued | sent | failed
  status    String    @default("queued")
  error     String?   @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([tenantId, createdAt])
}

/// A checkout attempt, created before the buyer is sent to Hyp's payment page.
///
/// Hyp's success URL is configured per TERMINAL, not per transaction, so the
/// completion redirect cannot carry the tenant or course in its URL. This row
/// is what makes the redirect meaningful: we pass its id as Hyp's `Order`
/// parameter and get it back, which is how one platform-wide return endpoint
/// resolves which tenant, which courses, and — critically — which amount was
/// supposed to be charged.
model PaymentOrder {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  /// Courses this order grants on payment. First one is the primary.
  courseIds        String[]           @db.Uuid
  /// What we asked Hyp to charge, in agorot. Compared against the amount Hyp
  /// reports back, so a tampered redirect cannot buy a course for less.
  amountAgorot     Int
  status           PaymentOrderStatus @default(PENDING)
  /// Buyer details collected before checkout — Hyp does not require them, but
  /// provisioning does (we create the student account from them).
  buyerEmail       String             @default("")
  buyerPhone       String             @default("")
  buyerName        String             @default("")
  /// Hyp's transaction id (`Id`) and status code (`CCode`) once it comes back.
  hypTransactionId String?
  ccode            String?
  failureReason    String?            @db.Text
  createdAt        DateTime           @default(now())
  completedAt      DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
}

/// Owner-configured email automation ("learning reminders"): a trigger plus a
/// message template with {{...}} variables. WELCOME fires inline when a student
/// is enrolled; INACTIVITY fires from the periodic sweep in /api/cron/automations.
model EmailAutomation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  /// WELCOME | INACTIVITY
  trigger   String
  /// For INACTIVITY: days without any learning activity before the nudge fires.
  days      Int      @default(3)
  subject   String
  body      String   @db.Text
  active    Boolean  @default(true)
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// Last time an automation reached a student — one row per pair, so an
/// inactivity nudge fires once per quiet spell instead of every sweep.
model AutomationSend {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  automationId String   @db.Uuid
  studentId    String   @db.Uuid
  sentAt       DateTime @default(now())

  @@unique([automationId, studentId])
  @@index([tenantId])
}

/// Platform-wide key/value config edited by the super-admin (e.g. 'packages' —
/// package prices + Grow payment links). Platform-level table, no RLS.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A platform sales lead from the marketing site's contact form. Platform-level
/// (no tenantId — like Tenant itself). When `contact` parses as a phone, the
/// platform WhatsApp bot greets the lead and books an appointment with them.
model Lead {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  /// Raw contact input (phone or email, as typed).
  contact       String
  /// Normalized E.164 phone when contact is a usable Israeli number.
  phone         String?
  message       String    @default("") @db.Text
  source        String    @default("landing")
  /// new | greeted | scheduled | closed
  status        String    @default("new")
  appointmentAt DateTime?
  /// Cal.com booking uid — set by the webhook; makes retried deliveries no-ops.
  calcomUid     String?
  /// Bot conversation state, e.g. { offeredSlots: [iso...] }.
  botState      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phone])
  @@index([createdAt])
}

/// Per-tenant API key for the public auto-enroll endpoint. Only the SHA-256
/// hash is stored; the plaintext is shown once at creation time.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  keyHash    String    @unique
  /// First characters of the plaintext, so the owner can tell keys apart.
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

/// A completed Grow payment: auto-provisions/enrolls the buyer and records the
/// sale. transactionId is unique per tenant for idempotent webhook delivery.
model Purchase {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  courseId          String   @db.Uuid
  /// Every course this one transaction granted. A Grow link may carry several
  /// products — one per course — and then all of them land here. `courseId`
  /// stays the first/primary so older rows and queries keep working, and the
  /// row count stays one-per-transaction so revenue isn't double-counted.
  courseIds         String[] @db.Uuid
  transactionId     String
  /// Which gateway settled this sale: "grow" (legacy links) or "hyp".
  provider          String   @default("grow")
  payerEmail        String
  payerPhone        String   @default("")
  payerName         String   @default("")
  amount            String   @default("")
  provisionedUserId String?  @db.Uuid
  isNewUser         Boolean  @default(false)
  delivered         Boolean  @default(false)
  deliveryError     String?  @db.Text
  /// Whether the buyer's receipt email actually went out, and why not if it
  /// didn't. WhatsApp delivery is tracked separately by `delivered`.
  mailedBuyer       Boolean  @default(false)
  mailError         String?  @db.Text
  createdAt         DateTime @default(now())

  @@unique([tenantId, transactionId])
  @@index([tenantId, createdAt])
}
