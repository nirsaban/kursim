generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EvictionPolicy {
  BLOCK
  EVICT_OLDEST
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum AttachmentKind {
  DOC
  IMAGE
  OTHER
}

/// Where a lesson video lives. Cloudinary caps an upload at the plan's video
/// size (100MB on Free), so anything larger is stored on this server's own
/// disk under MEDIA_ROOT instead.
enum MediaProvider {
  CLOUDINARY
  LOCAL
}

enum TranscriptStatus {
  NONE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Lifecycle of one lesson's semantic knowledge (chunks + embeddings), kept
/// separate from TranscriptStatus: this stage only starts once a transcript
/// and/or attachment text already exists. Only one version per lesson may be
/// ACTIVE (enforced by a partial unique index in the migration) — the mentor's
/// RAG retrieval only ever reads ACTIVE chunks.
enum KnowledgeVersionStatus {
  PENDING
  CHUNKING
  EMBEDDING
  ACTIVATING
  ACTIVE
  SUPERSEDED
  FAILED
}

enum KnowledgeChunkSource {
  VIDEO
  ATTACHMENT
}

model Tenant {
  id                String         @id @default(uuid()) @db.Uuid
  slug              String         @unique
  name              String
  status            TenantStatus   @default(ACTIVE)
  /// Billing package: FREE | STARTER | GROWTH | UNLIMITED (see lib/billing.ts).
  /// FREE builds courses but can't invite students or publish landing pages.
  plan              String         @default("FREE")
  planActivatedAt   DateTime?
  /// Monthly AI-mentor spend ceiling for this school, in US cents ($10 default).
  /// When the month's Gemini cost reaches it, the mentor pauses and the owner
  /// is offered a top-up. Super-admin edits it on the Costs page.
  mentorBudgetCents Int            @default(1000)
  sessionLimit      Int            @default(3)
  evictionPolicy    EvictionPolicy @default(BLOCK)
  /// Owner-customizable student-home content (validated by homepageSchema).
  homepage          Json?
  /// Owner branding: logo (small data URL), accent color, applied across the
  /// student UI + login (validated by brandingSchema).
  branding          Json?
  /// Academy terms gate: when enabled, students must accept before entering
  /// (validated by termsSchema). Bumping `version` re-prompts everyone.
  terms             Json?
  /// School-wide social channels (WhatsApp number, Instagram, …) shown on
  /// course landing pages and the LinkTree page (validated by socialsSchema).
  socials           Json?
  /// The school's public link-in-bio page at /t/{slug}/links (validated by
  /// linktreeSchema): links, theme, publish flag. Logo comes from `branding`.
  linktree          Json?
  /// Unique-visitor count for the linktree page (IP+UA deduped in Redis, same
  /// scheme as AffiliateLink.visits). Tenant has no RLS, so this is a plain column.
  linktreeViews     Int            @default(0)
  /// Secret embedded in the Grow payment-webhook URL to authenticate callbacks.
  webhookSecret     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users            User[]
  courses          Course[]
  invites          Invite[]
  modules          Module[]
  lessons          Lesson[]
  attachments      Attachment[]
  enrollments      Enrollment[]
  progress         Progress[]
  reviews          CourseReview[]
  affiliateLinks   AffiliateLink[]
  courseMedia      CourseMedia[]
  learningActivity LearningActivity[]
  authTokens       AuthToken[]
  planPayments     PlanPayment[]
  transcripts        Transcript[]
  transcriptSegments TranscriptSegment[]
  chapters           Chapter[]
  knowledgeVersions  KnowledgeVersion[]
  knowledgeChunks    KnowledgeChunk[]
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String?    @db.Uuid
  email                String
  name                 String?
  passwordHash         String
  role                 UserRole
  status               UserStatus @default(ACTIVE)
  mustChangePassword   Boolean    @default(false)
  /// WhatsApp phone (normalized 972…) — how the AI mentor recognizes the
  /// student when they message the school's number. Filled from purchases.
  phone                String?
  /// When the user accepted the tenant's terms, and which version. Null (or a
  /// stale version) with the gate enabled blocks the student UI until accepted.
  acceptedTermsAt      DateTime?
  acceptedTermsVersion Int        @default(0)
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  progress         Progress[]
  reviews          CourseReview[]
  affiliateLinks   AffiliateLink[]
  learningActivity LearningActivity[]
  authTokens       AuthToken[]

  @@unique([tenantId, email])
}

enum AuthTokenKind {
  RESET
}

/// Single-use, expiring token emailed to a user who can't log in. Only the
/// SHA-256 hash of the token is stored (same contract as Invite.tokenHash).
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  userId    String        @db.Uuid
  kind      AuthTokenKind @default(RESET)
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  tokenHash String    @unique
  email     String?
  role      UserRole  @default(STUDENT)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Course {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  title            String
  description      String?      @db.Text
  coverPublicId    String?
  status           CourseStatus @default(DRAFT)
  /// Short per-tenant catalog number the owner puts in the matching Grow
  /// product's "catalog_number" field. The payment callback matches on it to
  /// tell which course a buyer actually bought, so a bundle link can grant
  /// only what was paid for. Auto-assigned as max+1 on create; owner-editable.
  catalogNumber    Int
  /// Sale price in agorot (₪49.90 = 4990). Null means the course isn't sold
  /// through Hyp checkout — the landing CTA falls back to `marketing.paymentLink`.
  /// Agorot, not a decimal, so the amount we sign is exactly the amount we charge.
  priceAgorot      Int?
  marketing        Json?
  /// Owner toggle for the WhatsApp AI mentor on this course (plan-gated too).
  mentorEnabled    Boolean      @default(true)
  landingPublished Boolean      @default(false)
  /// Unique-visitor count for the public landing page — every visit, not just
  /// affiliate ?ref= ones (those still separately count on AffiliateLink.visits).
  landingViews     Int          @default(0)
  /// Unique visitors to the course's checkout (pre-payment) page.
  checkoutViews    Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules        Module[]
  enrollments    Enrollment[]
  reviews        CourseReview[]
  affiliateLinks AffiliateLink[]
  media          CourseMedia?
  knowledgeVersions KnowledgeVersion[]
  knowledgeChunks   KnowledgeChunk[]

  @@unique([tenantId, catalogNumber])
}

/// AI-generated marketing media for a course landing page: a Veo video rendered
/// as a 240-frame scroll-scrubbed hero sequence, plus Imagen stills. Public
/// (landing pages are public); the "media is never public" rule still governs lessons.
model CourseMedia {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  courseId      String   @unique @db.Uuid
  /// idle | generating | ready | failed
  status        String   @default("idle")
  /// Cloudinary base URL; individual frames appended as /frame_0001.jpg … frame_0240.jpg
  framesBaseUrl String?
  frameCount    Int      @default(240)
  posterUrl     String?
  videoUrl      String?
  /// [{ role, url, aspectRatio }]
  stills        Json?
  /// The full Gemini prompt-writer output, kept for re-runs and debugging.
  promptJson    Json?
  error         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CourseReview {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  courseId    String   @db.Uuid
  studentId   String   @db.Uuid
  name        String   @default("")
  rating      Int
  text        String   @db.Text
  /**
   * Private feedback for the owner — never shown on the landing page.
   */
  privateNote String   @default("") @db.Text
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

model AffiliateLink {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  courseId  String   @db.Uuid
  studentId String   @db.Uuid
  /**
   * Short public share code carried as ?ref= on the landing page.
   */
  code      String   @unique
  /**
   * Unique visitors who opened the landing page via this link.
   */
  visits    Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

model Module {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  courseId  String @db.Uuid
  title     String
  sortOrder Int    @default(0)
  /// Drip release: unlock this module only N days after the student enrolls (0 = immediate).
  dripDays  Int    @default(0)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  moduleId         String           @db.Uuid
  title            String
  notes            String?          @db.Text
  /// Auto-generated transcript of the lesson video — mentor knowledge source.
  transcript       String?          @db.Text
  /// Transcription lifecycle. Kept separate from `transcript` so "never ran"
  /// and "ran and produced nothing" stay distinguishable.
  transcriptStatus TranscriptStatus @default(NONE)
  /// BCP-47 tag of the transcribed speech ("he"). Null until one completes.
  transcriptLang   String?
  /// Last failure as a stable error code — never a signed URL or a key.
  transcriptError  String?
  transcribedAt    DateTime?
  videoPublicId    String?
  videoProvider    MediaProvider    @default(CLOUDINARY)
  durationSec      Int?
  sortOrder        Int              @default(0)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  progress    Progress[]
  structuredTranscript Transcript?
  chapters          Chapter[]
  knowledgeVersions KnowledgeVersion[]
  knowledgeChunks   KnowledgeChunk[]
}

model Attachment {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  lessonId      String           @db.Uuid
  publicId      String
  filename      String
  kind          AttachmentKind   @default(OTHER)
  /// Text content Gemini read out of the file (PDF text, image OCR) — a
  /// mentor knowledge source, same lifecycle contract as Lesson.transcript.
  extractedText String?          @db.Text
  textStatus    TranscriptStatus @default(NONE)
  textError     String?
  extractedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

/// Canonical structured transcript of one lesson's video — one row per lesson,
/// overwritten in place on reprocess (mirrors the existing Lesson.transcript
/// contract). `text` is the segments joined, kept for backward-compat display
/// and as the mentor's whole-course fallback brain.
model Transcript {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  lessonId        String   @unique @db.Uuid
  language        String
  text            String   @db.Text
  durationSec     Int?
  provider        String   @default("gemini")
  model           String
  /// Which LESSON_VIDEO_ANALYSIS_PROMPT_V* produced this — lets a future prompt
  /// change trigger deliberate reprocessing instead of silently mixing outputs.
  promptVersion   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson   Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  segments TranscriptSegment[]
  chapters Chapter[]
}

model TranscriptSegment {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  transcriptId String @db.Uuid
  sequence     Int
  startSeconds Float
  endSeconds   Float
  text         String @db.Text

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, sequence])
}

/// Auto-detected chapter within one lesson's transcript.
model Chapter {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  transcriptId String @db.Uuid
  lessonId     String @db.Uuid
  title        String
  summary      String @default("") @db.Text
  startSeconds Float
  endSeconds   Float
  sequence     Int

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([transcriptId, sequence])
}

/// One (re)indexing run of a lesson's knowledge (chunks + embeddings).
/// Append-only history; atomically activated so the mentor never mixes chunks
/// from two generations. Only one row per lessonId may have status ACTIVE —
/// enforced by a partial unique index created by hand in the migration SQL
/// (Prisma cannot express a partial unique constraint).
model KnowledgeVersion {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @db.Uuid
  courseId        String                 @db.Uuid
  lessonId        String                 @db.Uuid
  status          KnowledgeVersionStatus @default(PENDING)
  /// Bump when the chunking/indexing logic changes materially.
  processingVersion Int                  @default(1)
  promptVersion   String?
  embeddingModel  String?
  embeddingDim    Int?
  /// Stable error code only — never a raw message with a signed URL.
  error           String?
  createdAt       DateTime               @default(now())
  activatedAt     DateTime?
  supersededAt    DateTime?

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([lessonId])
  @@index([tenantId, courseId, status])
}

/// The retrievable unit for RAG. Snapshots its own content + timestamps, so a
/// superseded version's chunks stay valid even after the source Transcript /
/// Attachment.extractedText is later overwritten. The `embedding` column is a
/// pgvector `vector(768)` — Prisma has no native type for it, so it is
/// declared Unsupported and every read/write goes through raw parametrized
/// SQL in src/lib/knowledge/chunk-repository.ts (the one place that touches
/// this column directly).
model KnowledgeChunk {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @db.Uuid
  courseId           String               @db.Uuid
  lessonId           String               @db.Uuid
  knowledgeVersionId String               @db.Uuid
  sourceType         KnowledgeChunkSource
  attachmentId       String?              @db.Uuid
  content            String               @db.Text
  sequence           Int
  startSeconds       Float?
  endSeconds         Float?
  metadata           Json?
  embeddingModel     String
  /// vector(768) — see model doc comment. Never read/written via the Prisma
  /// client; raw SQL only.
  embedding          Unsupported("vector(768)")?
  createdAt          DateTime             @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson           Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  knowledgeVersion KnowledgeVersion @relation(fields: [knowledgeVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, courseId])
  @@index([knowledgeVersionId])
}

model Progress {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  studentId       String    @db.Uuid
  lessonId        String    @db.Uuid
  lastPositionSec Int       @default(0)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

/// One row per student per active learning day (any progress write that day).
/// Powers the streak counter and the journey activity calendar.
model LearningActivity {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  /// Calendar day in Asia/Jerusalem, stored as a DATE.
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId])
  @@index([tenantId, studentId])
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Extended platform features. All are tenant-owned (denormalized tenantId +
// RLS in the matching migration + registered in scoped-prisma TENANT_MODELS).
// FKs (incl. ON DELETE CASCADE) live in the migration SQL; author/student
// display names are denormalized to avoid a web of User back-relations.
// ─────────────────────────────────────────────────────────────────────────────

/// In-app notification for one user (bell menu). Fed by broadcasts, Q&A answers,
/// community replies, new reviews, certificates, etc.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  /// broadcast | qa_answer | community_reply | review | certificate | enroll
  type      String
  title     String
  body      String    @default("") @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, createdAt])
}

/// A message an owner blasts to students; delivery fans out into Notifications.
model Broadcast {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  authorId  String   @db.Uuid
  /// null = all students in the tenant; otherwise students enrolled in this course.
  courseId  String?  @db.Uuid
  subject   String
  body      String   @db.Text
  sentCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// A discussion thread in the tenant community.
model CommunityPost {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  authorId   String   @db.Uuid
  authorName String
  authorRole String
  title      String
  body       String   @db.Text
  pinned     Boolean  @default(false)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, pinned, createdAt])
}

/// A reply under a CommunityPost.
model CommunityReply {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  postId     String   @db.Uuid
  authorId   String   @db.Uuid
  authorName String
  authorRole String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([tenantId, postId, createdAt])
}

/// A student's question on a lesson, answered by staff.
model LessonQuestion {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  lessonId     String    @db.Uuid
  courseId     String    @db.Uuid
  studentId    String    @db.Uuid
  studentName  String
  body         String    @db.Text
  answer       String    @default("") @db.Text
  answeredById String?   @db.Uuid
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, lessonId, createdAt])
}

/// A code a student redeems to enroll in a course for free (giveaways / manual sales).
model AccessCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  courseId  String    @db.Uuid
  code      String    @unique
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, courseId])
}

/// A certificate issued when a student completes a course.
model Certificate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  courseId    String   @db.Uuid
  studentId   String   @db.Uuid
  studentName String   @default("")
  courseTitle String   @default("")
  serial      String   @unique
  issuedAt    DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([tenantId])
}

/// A student's private notes on one lesson.
model LessonNote {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  lessonId  String   @db.Uuid
  courseId  String   @db.Uuid
  body      String   @default("") @db.Text
  updatedAt DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([tenantId, studentId])
}

/// A catalog course a student saved for later.
model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  studentId String   @db.Uuid
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([tenantId, studentId])
}

/// A WhatsApp message the tenant sent (login deliveries, resends). Recorded when
/// queued, then updated by the worker gateway to sent/failed — powers the log.
model WhatsappMessage {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  toPhone   String
  body      String    @db.Text
  kind      String    @default("login")
  /// queued | sent | failed
  status    String    @default("queued")
  error     String?   @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([tenantId, createdAt])
}

/// A checkout attempt, created before the buyer is sent to Hyp's payment page.
///
/// Hyp's success URL is configured per TERMINAL, not per transaction, so the
/// completion redirect cannot carry the tenant or course in its URL. This row
/// is what makes the redirect meaningful: we pass its id as Hyp's `Order`
/// parameter and get it back, which is how one platform-wide return endpoint
/// resolves which tenant, which courses, and — critically — which amount was
/// supposed to be charged.
model PaymentOrder {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  /// Courses this order grants on payment. First one is the primary.
  courseIds        String[]           @db.Uuid
  /// What we asked Hyp to charge, in agorot. Compared against the amount Hyp
  /// reports back, so a tampered redirect cannot buy a course for less.
  amountAgorot     Int
  status           PaymentOrderStatus @default(PENDING)
  /// Buyer details collected before checkout — Hyp does not require them, but
  /// provisioning does (we create the student account from them).
  buyerEmail       String             @default("")
  buyerPhone       String             @default("")
  buyerName        String             @default("")
  /// Hyp's transaction id (`Id`) and status code (`CCode`) once it comes back.
  hypTransactionId String?
  ccode            String?
  failureReason    String?            @db.Text
  createdAt        DateTime           @default(now())
  completedAt      DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
}

/// Owner-configured email automation ("learning reminders"): a trigger plus a
/// message template with {{...}} variables. WELCOME fires inline when a student
/// is enrolled; INACTIVITY fires from the periodic sweep in /api/cron/automations.
model EmailAutomation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  /// WELCOME | INACTIVITY
  trigger   String
  /// For INACTIVITY: days without any learning activity before the nudge fires.
  days      Int      @default(3)
  subject   String
  body      String   @db.Text
  active    Boolean  @default(true)
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// Last time an automation reached a student — one row per pair, so an
/// inactivity nudge fires once per quiet spell instead of every sweep.
model AutomationSend {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  automationId String   @db.Uuid
  studentId    String   @db.Uuid
  sentAt       DateTime @default(now())

  @@unique([automationId, studentId])
  @@index([tenantId])
}

/// Platform-wide key/value config edited by the super-admin (e.g. 'packages' —
/// package prices + Grow payment links). Platform-level table, no RLS.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A platform sales lead from the marketing site's contact form. Platform-level
/// (no tenantId — like Tenant itself). When `contact` parses as a phone, the
/// platform WhatsApp bot greets the lead and books an appointment with them.
model Lead {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  /// Raw contact input (phone or email, as typed).
  contact       String
  /// Normalized E.164 phone when contact is a usable Israeli number.
  phone         String?
  message       String    @default("") @db.Text
  source        String    @default("landing")
  /// new | greeted | scheduled | closed
  status        String    @default("new")
  appointmentAt DateTime?
  /// Cal.com booking uid — set by the webhook; makes retried deliveries no-ops.
  calcomUid     String?
  /// Bot conversation state, e.g. { offeredSlots: [iso...] }.
  botState      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phone])
  @@index([createdAt])
}

/// Platform-level table like Lead: no RLS. One row per Grow package payment
/// (first charge and every standing-order cycle). transactionId's unique
/// constraint is the webhook's idempotency guard; tenantId/plan stay null when
/// the payer email couldn't be matched to exactly one school owner — those
/// rows are resolved by hand from the super-admin packages page.
model PlanPayment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @db.Uuid
  /// Detected package (STARTER/GROWTH/UNLIMITED); null = needs manual handling.
  plan          String?
  amount        String   @default("")
  payerEmail    String   @default("")
  payerName     String   @default("")
  transactionId String   @unique
  createdAt     DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
}

/// One row per school per month: AI-mentor token usage. Cost is derived from
/// tokens at display time, so a price change never rewrites history.
model MentorUsage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  /// Calendar month, '2026-08'.
  month        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  messages     Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, month])
  @@index([month])
}

/// Per-tenant API key for the public auto-enroll endpoint. Only the SHA-256
/// hash is stored; the plaintext is shown once at creation time.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  keyHash    String    @unique
  /// First characters of the plaintext, so the owner can tell keys apart.
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

/// A completed Grow payment: auto-provisions/enrolls the buyer and records the
/// sale. transactionId is unique per tenant for idempotent webhook delivery.
model Purchase {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  courseId          String   @db.Uuid
  /// Every course this one transaction granted. A Grow link may carry several
  /// products — one per course — and then all of them land here. `courseId`
  /// stays the first/primary so older rows and queries keep working, and the
  /// row count stays one-per-transaction so revenue isn't double-counted.
  courseIds         String[] @db.Uuid
  transactionId     String
  /// Which gateway settled this sale: "grow" (legacy links) or "hyp".
  provider          String   @default("grow")
  payerEmail        String
  payerPhone        String   @default("")
  payerName         String   @default("")
  amount            String   @default("")
  provisionedUserId String?  @db.Uuid
  isNewUser         Boolean  @default(false)
  delivered         Boolean  @default(false)
  deliveryError     String?  @db.Text
  /// Whether the buyer's receipt email actually went out, and why not if it
  /// didn't. WhatsApp delivery is tracked separately by `delivered`.
  mailedBuyer       Boolean  @default(false)
  mailError         String?  @db.Text
  createdAt         DateTime @default(now())

  @@unique([tenantId, transactionId])
  @@index([tenantId, createdAt])
}
